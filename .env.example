# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://headlines:headlines@localhost:5432/headlines

# Public origin for canonical links and link previews (optional locally)
# SITE_URL=https://headlinehub.example

# Sign-in emails via Resend (optional locally: links are printed in the terminal)
# RESEND_API_KEY=re_...
# EMAIL_FROM="Headline Hub <signin@headlinehub.example>"

# Hour (server local time) the daily digest goes out; used by npm run notify
# DIGEST_HOUR=7

# Accounts (comma-separated) that can review publisher feed submissions at /admin/submissions
# ADMIN_EMAILS=you@example.com
