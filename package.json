{
  "name": "headline-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ingest": "tsx --env-file-if-exists=.env.local src/worker/ingest.ts",
    "ingest:watch": "tsx --env-file-if-exists=.env.local src/worker/ingest.ts --watch",
    "recluster": "tsx --env-file-if-exists=.env.local src/worker/recluster.ts",
    "tag-countries": "tsx --env-file-if-exists=.env.local src/worker/tag-countries.ts",
    "notify": "tsx --env-file-if-exists=.env.local src/worker/notify.ts",
    "notify:watch": "tsx --env-file-if-exists=.env.local src/worker/notify.ts --watch",
    "check-feeds": "tsx src/worker/check-feeds.ts",
    "cf:feed-check:deploy": "wrangler deploy --config cloudflare/feed-check/wrangler.jsonc"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
